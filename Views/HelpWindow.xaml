<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TypeIt4Me.Views.HelpWindow" Title="Help &amp; about &#xB7; TypeIt4Me" Width="620" Height="720" MinWidth="460" MinHeight="480" Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="24,24,24,16">
            <TextBlock Text="A few words go a long way" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Get comfortable with TypeIt4Me." Style="{StaticResource HelperText}" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer x:Name="HelpContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,16">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="From saved text to the active app" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="1. Create a snippet with a name and the text you reuse.&#10;2. Click the text field in the app you want to type into.&#10;3. Return here and click the snippet, or press its global hotkey.&#10;TypeIt4Me returns focus to the last app and sends the text." Style="{StaticResource HelperText}" Margin="0,10,0,0"/>
                        <TextBlock Text="Hotkeys are key combinations, such as Ctrl + Alt + E. Typing an abbreviation does not automatically expand it. Some apps, elevated windows, and reserved shortcuts may not accept input." Style="{StaticResource HelperText}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Move quickly with the keyboard" Style="{StaticResource SectionText}"/>
                        <TextBlock FontFamily="{StaticResource CodeFont}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" Text="Ctrl+F       Search snippets&#10;Down         Move from search to the results&#10;Enter        Insert the selected snippet&#10;F2           Edit the selected snippet&#10;Delete       Confirm deletion&#10;Shift+F10    Open snippet actions&#10;Ctrl+N       New snippet&#10;Ctrl+M       Enter or leave Mini Mode&#10;Ctrl+,       Settings&#10;Ctrl+L       Lock (when a PIN is set)&#10;F1           Help&#10;Ctrl+S       Save in the editor&#10;Escape       Clear search or cancel a dialog"/>
                        <TextBlock Text="Tab and Shift+Tab move through controls. In the content editor, Enter creates a new line and Tab leaves the field. Alt+Space opens the standard Windows system menu." Style="{StaticResource HelperText}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Mini Mode &amp; tray" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="Mini Mode keeps search and snippet insertion close at hand. Drag its title bar to move it; use the expand button or Ctrl+M to return. Keyboard editing and snippet actions still work. Full and Mini Mode sizes are remembered separately.&#10;&#10;The pin button keeps the window above other apps. When tray mode is enabled, closing or minimizing keeps TypeIt4Me running. Double-click its tray icon to restore; choose Exit from the tray menu to quit." Style="{StaticResource HelperText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Text with a few extra moves" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="Combine literal text with commands in braces. Commands are case-insensitive. Unknown commands are typed literally." Style="{StaticResource HelperText}" Margin="0,10,0,12"/>
                        <TextBlock Text="Hello{TAB}World{ENTER}&#10;Starting&#x2026;{SLEEP 1000}Done!" FontFamily="{StaticResource CodeFont}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Navigation: TAB, ENTER / RETURN, ESC / ESCAPE, BACKSPACE, DELETE / DEL, INSERT / INS, HOME, END, PAGEUP / PGUP, PAGEDOWN / PGDN, SPACE.&#10;Arrows: UP, DOWN, LEFT, RIGHT (ARROW aliases also work).&#10;Other keys: F1&#x2013;F12, CAPSLOCK / CAPS, NUMLOCK, SCROLLLOCK, PRINTSCREEN / PRTSC.&#10;Modifier presses: SHIFT, CTRL / CONTROL, ALT, WINKEY / WIN / LWIN / RWIN. Each sends a press and release; it does not hold the modifier for the next character.&#10;SLEEP pauses for 1&#x2013;60,000 milliseconds." Style="{StaticResource HelperText}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Privacy, plainly explained" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="When a PIN is set, stored snippets and exports use the existing V3 AES-256-CBC format with HMAC-SHA256 authentication. PIN hashes use PBKDF2-SHA256 with a unique salt and 600,000 iterations. Without a PIN, snippets and exports are plain text. There is no PIN recovery.&#10;&#10;Locking hides snippets and blocks snippet actions and global hotkey execution. The collection remains in process memory; locking is not a guarantee that all text has been erased from RAM.&#10;&#10;TypeIt4Me sends text through Windows SendInput without copying it to the clipboard. Commands that press keys may cause the target application to perform its own actions.&#10;&#10;Snippets: %AppData%\TypeIt4Me\snippets.json&#10;Settings: %AppData%\TypeIt4Me\settings.json&#10;Errors: %AppData%\TypeIt4Me\error.log" Style="{StaticResource HelperText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="About TypeIt4Me" Style="{StaticResource SectionText}"/>
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="Created by L&#xE9;on &#x201C;Avic&#x201D; Simmons and contributors." Style="{StaticResource HelperText}"/>
                        <Button Content="View source on GitHub" Click="Source_Click" HorizontalAlignment="Left" Margin="0,12,0,12"/>
                        <TextBlock Text="TypeIt4Me is licensed under the MIT License. The existing application icon is from Google Material Symbols, licensed under Apache 2.0. Interface stroke icons are original TypeIt4Me assets under MIT. Fonts are supplied by Windows. See LICENSE in the source repository for the full license terms." Style="{StaticResource HelperText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <Button Content="_Done" Click="Done_Click" IsCancel="True" HorizontalAlignment="Right" Style="{StaticResource AccentButton}"/>
        </Border>
    </Grid>
</Window>
