<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:TypeIt4Me.Views.Controls" x:Class="TypeIt4Me.Views.PinEntryWindow" Title="PIN &#xB7; TypeIt4Me" Width="420" SizeToContent="Height" MinWidth="360" MaxWidth="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <ScrollViewer x:Name="DialogContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource SpaceLarge}">
            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                <ui:SymbolIcon Data="{StaticResource IconLock}" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <TextBlock x:Name="HeadingText" Text="Unlock TypeIt4Me" Style="{StaticResource TitleText}" Margin="0,20,0,8"/>
            <TextBlock x:Name="DescriptionText" Text="Enter your PIN to access your snippets." Style="{StaticResource HelperText}" Margin="0,0,0,20"/>
            <Label Content="_PIN" Target="{Binding ElementName=PinBox}" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PinBox" FontSize="18" MinHeight="44" AutomationProperties.Name="PIN" PasswordChanged="PinBox_PasswordChanged"/>
            <StackPanel x:Name="ConfirmationPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <Label Content="_Confirm PIN" Target="{Binding ElementName=ConfirmBox}" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="ConfirmBox" FontSize="18" MinHeight="44" AutomationProperties.Name="Confirm PIN"/>
                <TextBlock Text="Use at least 4 characters; 6 or more is recommended. Keep your PIN safe. There is no recovery option." Style="{StaticResource HelperText}" Margin="0,8,0,0"/>
            </StackPanel>
            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="SubmitButton" Content="_Unlock" IsDefault="True" Click="OK_Click" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
