<Window x:Class="TypeIt4Me.Views.PinEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeIt4Me Security" Height="150" Width="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Enter PIN:" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PinBox" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
             <Button Content="OK" IsDefault="True" Click="OK_Click" Width="60" Margin="0,0,10,0"/>
             <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Width="60"/>
        </StackPanel>
    </StackPanel>
</Window>
