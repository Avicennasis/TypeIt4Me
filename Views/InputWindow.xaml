<Window x:Class="TypeIt4Me.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeIt4Me" Height="140" Width="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="MessageText" Text="Enter Value:" Foreground="{DynamicResource TextForeground}" Margin="0,0,0,10"/>
        
        <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,0,0,10" Padding="5" 
                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Click="OK_Click" Width="60" Margin="0,0,10,0" Padding="5"/>
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Width="60" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>
