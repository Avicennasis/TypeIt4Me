<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:TypeIt4Me.Views.Controls" x:Class="TypeIt4Me.Views.MessageWindow" Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <ScrollViewer x:Name="DialogContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource SpaceLarge}">
            <ui:SymbolIcon x:Name="MessageIcon" Data="{StaticResource IconCheck}" Width="28" Height="28" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="HeadingText" Style="{StaticResource TitleText}" Margin="0,18,0,12"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource HelperText}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Content="_Continue" Click="Confirm_Click" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
