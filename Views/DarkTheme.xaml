    <SolidColorBrush x:Key="TextForeground" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="ListBackground" Color="#252526"/>
    <SolidColorBrush x:Key="ListAltBackground" Color="#3E3E42"/>
