<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:tb="http://www.hardcodet.net/taskbar" xmlns:ui="clr-namespace:TypeIt4Me.Views.Controls" x:Class="TypeIt4Me.Views.MainWindow" Title="TypeIt4Me" Width="420" Height="620" MinWidth="320" MinHeight="400" Style="{StaticResource AppWindow}" Topmost="{Binding IsAlwaysOnTop}" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddSnippetCommand}"/>
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding ToggleMiniModeCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding ShowSettingsCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="FullOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsMiniMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="IsTabStop" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsMiniMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowActivation" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsMiniMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="8,4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnippetItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="AutomationProperties.HelpText" Value="Press Enter to insert, F2 to edit, or Shift+F10 for more actions."/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsMiniMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <tb:TaskbarIcon x:Name="TaskbarIcon" IconSource="pack://application:,,,/TypeIt4Me;component/TypeIt4Me.ico" ToolTipText="TypeIt4Me &#xB7; instant access to your text" MenuActivation="RightClick" DoubleClickCommand="{Binding RestoreFromTrayCommand}">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Show TypeIt4Me" Command="{Binding RestoreFromTrayCommand}"/>
                        <MenuItem Header="E_xit" Click="Exit_Click"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
            <!-- WindowChrome supplies dragging, resizing, double-click and the system menu. -->
            <Grid Margin="12,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Margin="0,0,8,0">
                        <ui:SymbolIcon Data="{StaticResource IconText}" Foreground="{DynamicResource AccentBrush}" Width="14" Height="14"/>
                    </Border>
                    <TextBlock Text="TypeIt4Me" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ToggleButton IsChecked="{Binding IsAlwaysOnTop}" Style="{StaticResource IconToggle}" ToolTip="Keep above other windows" AutomationProperties.Name="Always on top">
                        <ui:SymbolIcon Data="{StaticResource IconPin}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <Button Command="{Binding ToggleMiniModeCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="Toggle Mini Mode" ToolTip="Mini Mode / expand (Ctrl+M)">
                        <ui:SymbolIcon>
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
                                    <Setter Property="Data" Value="{StaticResource IconMini}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMiniMode}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconExpand}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Button>
                    <Button Click="Minimize_Click" Style="{StaticResource IconButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <ui:SymbolIcon Data="{StaticResource IconMinimize}"/>
                    </Button>
                    <Button Click="Close_Click" Style="{StaticResource IconButton}" ToolTip="Close (keeps running when tray mode is on)" AutomationProperties.Name="Close">
                        <ui:SymbolIcon Data="{StaticResource IconClose}"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="16,12,16,16" Style="{StaticResource FullOnly}" IsEnabled="{Binding IsUnlocked}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Your snippets" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Useful words. One step away." Style="{StaticResource HelperText}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding AddSnippetCommand}" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="New snippet (Ctrl+N)" AutomationProperties.Name="New snippet">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Data="{StaticResource IconAdd}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                        <TextBlock Text="New" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="2" Margin="16,0,16,12" IsEnabled="{Binding IsUnlocked}">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Find a snippet" Padding="36,9,36,9" MinHeight="40" AutomationProperties.Name="Search snippets" AutomationProperties.HelpText="Search names, categories, content, or hotkeys. Press Down to browse results and Enter to insert."/>
                <ui:SymbolIcon Data="{StaticResource IconSearch}" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="{DynamicResource SecondaryBrush}"/>
                <Button Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right" Margin="2" MinHeight="32" MinWidth="32" ToolTip="Clear search" AutomationProperties.Name="Clear search">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <ui:SymbolIcon Data="{StaticResource IconClose}" Width="12" Height="12"/>
                </Button>
            </Grid>
            <Grid Grid.Row="3" Margin="16,0,16,0">
                <ListBox x:Name="SnippetList" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}" ItemsSource="{Binding FilteredSnippets}" SelectedItem="{Binding SelectedSnippet}" ItemContainerStyle="{StaticResource SnippetItem}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Snippets" PreviewMouseRightButtonDown="SnippetList_PreviewMouseRightButtonDown">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="_Insert snippet" Command="{Binding UseSelectedSnippetCommand}" InputGestureText="Enter"/>
                            <MenuItem Header="_Edit snippet" Command="{Binding EditSelectedSnippetCommand}" InputGestureText="F2"/>
                            <Separator/>
                            <MenuItem Header="_Delete snippet&#x2026;" Command="{Binding DeleteSelectedSnippetCommand}" InputGestureText="Delete" Foreground="{DynamicResource DangerBrush}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RowActivation}" Command="{Binding DataContext.TriggerSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Insert {0}'}" ToolTip="Insert this snippet into the last active app">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource SecondaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" Style="{StaticResource FullOnly}"/>
                                            <WrapPanel>
                                                <WrapPanel.Style>
                                                    <Style TargetType="WrapPanel">
                                                        <Setter Property="Margin" Value="0,6,0,0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsMiniMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Margin" Value="0,2,0,0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </WrapPanel.Style>
                                                <TextBlock Text="{Binding Category}" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,10,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Category}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.IsMiniMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding HotkeyLabel}" FontFamily="{StaticResource CodeFont}" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource SecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HotkeyLabel}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </WrapPanel>
                                        </StackPanel>
                                        <ui:SymbolIcon Grid.Column="1" Data="{StaticResource IconInsert}" Foreground="{DynamicResource AccentBrush}" Width="14" Height="14"/>
                                    </Grid>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource RowAction}" VerticalAlignment="Center" Command="{Binding DataContext.EditSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Edit snippet (F2)" AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}">
                                    <ui:SymbolIcon Data="{StaticResource IconEdit}" Width="14" Height="14"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource RowAction}" VerticalAlignment="Center" Click="SnippetMore_Click" ToolTip="More snippet actions" AutomationProperties.Name="{Binding Name, StringFormat='More actions for {0}'}">
                                    <ui:SymbolIcon Data="{StaticResource IconMore}" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="12,30" VerticalAlignment="Center">
                        <Border Width="56" Height="56" Background="{DynamicResource AccentSoftBrush}" CornerRadius="14" HorizontalAlignment="Left">
                            <ui:SymbolIcon Data="{StaticResource IconText}" Foreground="{DynamicResource AccentBrush}" Width="26" Height="26"/>
                        </Border>
                        <TextBlock Text="Make room for your words" Style="{StaticResource SectionText}" Margin="0,18,0,8"/>
                        <TextBlock Text="Save an email address, a reply, or anything you type often. Your first snippet starts here." Style="{StaticResource HelperText}"/>
                        <Button Content="Create a snippet" Command="{Binding AddSnippetCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" Margin="16">
                    <TextBlock Text="No matching snippets" Style="{StaticResource SectionText}"/>
                    <TextBlock Text="Try a different name, category, or phrase." Style="{StaticResource HelperText}" Margin="0,8,0,16"/>
                    <Button Content="Clear search" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="16,20">
                        <ui:SymbolIcon Data="{StaticResource IconLock}" Width="32" Height="32" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Snippets locked" Style="{StaticResource SectionText}" Margin="0,12,0,8"/>
                        <TextBlock Text="Enter your PIN to access your snippets. Global snippet hotkeys are paused." Style="{StaticResource HelperText}" Margin="0,0,0,20"/>
                        <Button Content="Unlock TypeIt4Me" Command="{Binding UnlockCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" IsDefault="True"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Margin" Value="0,12,0,0"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMiniMode}" Value="True">
                                <Setter Property="Margin" Value="0,6,0,0"/>
                                <Setter Property="Padding" Value="12,4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Style="{StaticResource FullOnly}">
                            <Button Command="{Binding LockCommand}" Style="{StaticResource IconButton}" ToolTip="Lock snippets (Ctrl+L)" AutomationProperties.Name="Lock snippets">
                                <ui:SymbolIcon Data="{StaticResource IconLock}" Width="14" Height="14"/>
                            </Button>
                            <Button Command="{Binding ShowSettingsCommand}" Style="{StaticResource IconButton}" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
                                <ui:SymbolIcon Data="{StaticResource IconSettings}" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding ResultSummary}" FontSize="{StaticResource TypeCaption}" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource TypeCaption}" TextWrapping="Wrap" Margin="0,4,0,2" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMiniMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMiniMode}" Value="True"/>
                                            <Condition Binding="{Binding StatusIsError}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
