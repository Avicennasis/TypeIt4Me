<Window x:Class="TypeIt4Me.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:vm="clr-namespace:TypeIt4Me.ViewModels"
        mc:Ignorable="d"
        Title="TypeIt4Me" Height="500" Width="350"
        Topmost="{Binding IsAlwaysOnTop}"
        Icon="/TypeIt4Me.ico"
        Background="{DynamicResource WindowBackground}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MiniModeStyle" TargetType="Window">
            <Setter Property="SizeToContent" Value="Manual"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tray Icon -->
        <tb:TaskbarIcon x:Name="TaskbarIcon"
                        IconSource="/TypeIt4Me.ico"
                        ToolTipText="TypeIt4Me"
                        MenuActivation="RightClick"
                        DoubleClickCommand="{Binding RestoreFromTrayCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Command="{Binding RestoreFromTrayCommand}" />
                    <MenuItem Header="Exit" Click="Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Tag="Search..."
                     Padding="5"
                     Background="{DynamicResource InputBackground}"
                     Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource ListBorder}"/>
            
            <CheckBox Content="📌" 
                      ToolTip="Always on Top"
                      IsChecked="{Binding IsAlwaysOnTop}"
                      Grid.Column="1" 
                      Margin="10,0,0,0" 
                      Foreground="{DynamicResource TextForeground}"
                      VerticalAlignment="Center">
                  <CheckBox.Style>
                      <Style TargetType="CheckBox">
                          <Style.Triggers>
                              <DataTrigger Binding="{Binding IsMiniMode}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                          </Style.Triggers>
                      </Style>
                  </CheckBox.Style>
            </CheckBox>
            
            <CheckBox Content="🤏" 
                      ToolTip="Mini Mode"
                      IsChecked="{Binding IsMiniMode}"
                      Grid.Column="2" 
                      Margin="10,0,0,0" 
                      Foreground="{DynamicResource TextForeground}"
                      VerticalAlignment="Center"/>
                      
            <Menu Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" Background="Transparent">
                <MenuItem Header="☰" Foreground="{DynamicResource TextForeground}">
                    <MenuItem Header="Import Snippets..." Command="{Binding ImportSnippetsCommand}" Foreground="Black"/>
                    <MenuItem Header="Export Snippets..." Command="{Binding ExportSnippetsCommand}" Foreground="Black"/>
                    <Separator/>
                    <MenuItem Header="Set/Change PIN..." Command="{Binding SetPinCommand}" Foreground="Black"/>
                    <MenuItem Header="Remove PIN..." Command="{Binding RemovePinCommand}" Foreground="Black"/>
                    <Separator/>
                    <MenuItem Header="Minimize to Tray" IsCheckable="True" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Foreground="Black"/>
                    <MenuItem Header="Dark Mode" IsCheckable="True" IsChecked="{Binding IsDarkMode, Mode=TwoWay}" Foreground="Black"/>
                    <Separator/>
                    <MenuItem Header="Lock on Restore" IsCheckable="True" IsChecked="{Binding LockOnRestore, Mode=TwoWay}" Foreground="Black"/>
                    <MenuItem Header="Auto-Lock" Foreground="Black">
                        <MenuItem Header="Off" IsCheckable="True" IsChecked="{Binding IsAutoLockOff, Mode=OneWay}" Command="{Binding SetAutoLockCommand}" CommandParameter="0"/>
                        <MenuItem Header="1 Minute" IsCheckable="True" IsChecked="{Binding IsAutoLock1Min, Mode=OneWay}" Command="{Binding SetAutoLockCommand}" CommandParameter="1"/>
                        <MenuItem Header="5 Minutes" IsCheckable="True" IsChecked="{Binding IsAutoLock5Min, Mode=OneWay}" Command="{Binding SetAutoLockCommand}" CommandParameter="5"/>
                        <Separator/>
                        <MenuItem Header="Custom..." Command="{Binding SetCustomAutoLockCommand}"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Help &amp; About" Command="{Binding ShowHelpCommand}" Foreground="Black"/>
                </MenuItem>
            </Menu>
        </Grid>

         <!-- Snippet List -->
        <ListView Grid.Row="2" 
                  ItemsSource="{Binding FilteredSnippets}" 
                  BorderThickness="0,1" 
                  BorderBrush="{DynamicResource ListBorder}"
                  Background="{DynamicResource ListBackground}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AlternationCount="2"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{DynamicResource ListAltBackground}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextForeground}"/>
                            <TextBlock Text="{Binding TriggerKey, StringFormat='Hotkey: {0}'}" FontSize="10" Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TriggerKey}" Value="None">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="DarkGray" FontStyle="Italic"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="▶" Command="{Binding DataContext.TriggerSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}"
                                    ToolTip="Insert Snippet"
                                    Width="25" Height="25" Margin="0,0,5,0"/>
                            <Button Content="✎" Command="{Binding DataContext.EditSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}"
                                    ToolTip="Edit"
                                    Width="25" Height="25" Margin="0,0,5,0"/>
                            <Button Content="🗑" Command="{Binding DataContext.DeleteSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}"
                                    ToolTip="Delete"
                                    Width="25" Height="25"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom Bar -->
        <Button Grid.Row="3" Content="+ New Snippet" 
                Command="{Binding AddSnippetCommand}" 
                Margin="10" Padding="10"
                Background="{DynamicResource ControlHover}"
                Foreground="{DynamicResource TextForeground}"
                BorderBrush="{DynamicResource ListBorder}">
              <Button.Style>
                  <Style TargetType="Button">
                      <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMiniMode}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                      </Style.Triggers>
                  </Style>
              </Button.Style>
        </Button>
    </Grid>
</Window>
