<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextForeground" Color="#000000"/>
    <SolidColorBrush x:Key="ListBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ListAltBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ListBorder" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputForeground" Color="#000000"/>
    <SolidColorBrush x:Key="ControlHover" Color="#E5F1FB"/>
</ResourceDictionary>
